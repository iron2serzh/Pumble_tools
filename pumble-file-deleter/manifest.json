{
  "manifest_version": 3,
  "name": "Pumble — usuń pliki",
  "version": "0.5.0",
  "description": "Na widoku Files kasuje ostatnią stronę, wraca na stronę 1 i czyta paginację od nowa. Potwierdzenie, postęp i Stop.",
  "content_scripts": [
    {
      "matches": ["https://app.pumble.com/*"],
      "js": [
        "src/list-files.js",
        "src/wait-for.js",
        "src/delete-session.js",
        "src/panel.js",
        "src/content.js"
      ],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ]
}
